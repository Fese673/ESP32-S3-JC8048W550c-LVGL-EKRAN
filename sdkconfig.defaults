# This file was generated using idf.py save-defconfig. It can be edited manually.
# Espressif IoT Development Framework (ESP-IDF) 5.2.0 Project Minimal Configuration
#
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="parts.csv"
CONFIG_PARTITION_TABLE_FILENAME="parts.csv"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000
CONFIG_LV_USE_SYSMON=y       # LVGL Monitor System
CONFIG_LV_USE_PERF_MONITOR=y # LVGL Performance Monitor


CONFIG_LV_CONF_SKIP=y
CONFIG_LV_USE_BUILTIN_MALLOC=n
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_MEMCPY_MEMSET_STD=y
CONFIG_LV_DEF_REFR_PERIOD=15
CONFIG_LV_DRAW_LAYER_SIMPLE_BUF_SIZE=524288
CONFIG_LV_USE_USER_DATA=y
CONFIG_LV_USE_CHART=y
CONFIG_LV_USE_DEMO_WIDGETS=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_18=y
CONFIG_LV_FONT_MONTSERRAT_30=y
CONFIG_LV_FONT_MONTSERRAT_48=y

# Optymalizacje wydajności silnika rysującego
CONFIG_LV_CACHE_DEF_SIZE=204800
CONFIG_LV_DRAW_SW_SHADOW_CACHE_SIZE=32
CONFIG_LV_DRAW_SW_CIRCLE_CACHE_SIZE=32
CONFIG_LV_USE_THORVG_INTERNAL=y

# === Optymalizacje CPU Core 1 (LVGL) ===
# FAST_MEM_USE_IRAM: wyłączone — powoduje konflikt sekcji w LVGL 9.4 (compiler error)
CONFIG_LV_OBJ_STYLE_CACHE=y                 # Cache stylów na obiektach
CONFIG_LV_IMAGE_HEADER_CACHE_DEF_CNT=8      # Cache nagłówków obrazów
# Uwaga: PPA (Pixel Processing Accelerator) NIE jest obsługiwany na ESP32-S3 w IDF 6.0.1
CONFIG_LV_OS_FREERTOS=y
CONFIG_LV_DRAW_SW_SUPPORT_ESP32S3=y
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=1

CONFIG_COMPILER_OPTIMIZATION_PERF=y


CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# Enabling the following configurations can help increase the PCLK frequency in the case when
# the Frame Buffer is allocated from the PSRAM and fetched by EDMA
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=0

# LVGL performance diagnostics (UART-only, no UI impact — disable for release)
CONFIG_LV_PERF_DIAG=y
CONFIG_LV_PERF_DIAG_INTERVAL_MS=1000
CONFIG_LV_PERF_DIAG_HEARTBEAT_SKIP=4

